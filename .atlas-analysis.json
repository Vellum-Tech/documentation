  "keyFeatures": [
    "Visual workflow builder for multi-step LLM applications",
    "Prompt engineering sandbox with versioning and deployments",
    "Quantitative evaluation with built-in and custom metrics",
    "Online evaluations for continuous production monitoring",
    "Document indexing and RAG (retrieval-augmented generation) pipelines",
    "Multi-environment deployment lifecycle management",
    "Python, Node/TypeScript, and Go SDK clients",
    "Agent Builder for autonomous tool-calling workflows",
    "Collaborative workspace for technical and non-technical teams",
    "Execution logs, cost tracking, and latency analytics"
  ],
